# Streamlit Secrets Configuration
# This is an EXAMPLE ONLY - Never commit real secrets to GitHub!
#
# Instructions:
# 1. On Streamlit Community Cloud, go to your app settings
# 2. Click "Secrets" in the sidebar
# 3. Copy the values below and replace with your actual API keys
# 4. Paste into the Streamlit secrets editor
#
# For local development, create a file at:
# ~/.streamlit/secrets.toml (global) or
# .streamlit/secrets.toml (project-specific)

OPENAI_API_KEY = "sk-proj-your-openai-key-here"
EXA_API_KEY = "your-exa-api-key-here"
OPENAI_API_BASE = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-4o"
